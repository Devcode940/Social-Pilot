# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite file (relative to project root). The file itself is gitignored.
DATABASE_URL="file:./db/custom.db"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Must match the public origin in production (used for auth callbacks).
NEXTAUTH_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="change-me-in-production"

# ─── Scheduler cron ───────────────────────────────────────────────────────────
# Shared secret for GET /api/scheduler/cron (external cron services).
# Call with header `x-cron-secret: <secret>` or `?secret=<secret>`.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="change-me-in-production"

# ─── AI features (Z-AI) ───────────────────────────────────────────────────────
# AI routes (trends, ai-writer, ai-video, ai-reply, ai-schedule, generate-image,
# comments sentiment, competitors/hashtags/copyright search) require a
# `.z-ai-config` file (project root, home dir, or /etc) with valid credentials.
# Without it those endpoints return HTTP 500 with a clear message; the rest of
# the app works normally.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV="development"

# ─── Temporary demo mode (NO LOGIN) ───────────────────────────────────────────
# Set both to "true" to skip logins app-wide (acts as the demo user).
# Honored ONLY when NODE_ENV != "production". NEVER enable in production.
# AUTH_BYPASS="true"
# NEXT_PUBLIC_AUTH_BYPASS="true"
